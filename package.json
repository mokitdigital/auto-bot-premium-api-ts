{
  "name": "auto-bot-premium-api-ts",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:make": "knex --knexfile knexfile.ts migrate:make",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback"
  },
  "dependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "nodemon": "^3.1.9",
    "pg": "^8.14.1",
    "socket.io": "^4.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "venom-bot": "^5.3.0",
    "ws": "^8.18.1"
  }
}
